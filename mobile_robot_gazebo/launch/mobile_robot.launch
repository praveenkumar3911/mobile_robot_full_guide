<launch>
    <!--arg name="model" default="$(env mobile_robot_MODEL)" doc="model type [mobile_robot, remo]"/-->
    <arg name="model" default="mobile_robot" doc="model type [mobile_robot, remo]"/>

    <arg name="rvizconfig" default="$(find mobile_robot_control)/rviz/mobile_robot.rviz" />
    <arg name="world_name" default="$(find mobile_robot_gazebo)/worlds/db_world.world"/>

    <include file="$(find mobile_robot_gazebo)/launch/mobile_robot_view.launch">
        <arg name="model" value="$(arg model)" />
        <arg name="world_name" value="$(arg world_name)"/>
    </include>

    <include file="$(find mobile_robot_control)/launch/mobile_robot_control.launch">
        <arg name="model" value="$(arg model)" />
    </include>

</launch>